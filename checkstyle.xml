<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Pragmatic Checkstyle ruleset for sync-bridge-java.
    Focuses on correctness and real bugs rather than formatting style,
    so existing code passes without mass reformatting.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- No trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!-- Files must end with a newline -->
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">

        <!-- ── Imports ─────────────────────────────────────────────────── -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>  <!-- blocks sun.* -->

        <!-- ── Naming conventions ──────────────────────────────────────── -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>           <!-- PascalCase classes/interfaces -->
        <module name="MethodName"/>         <!-- camelCase methods -->
        <module name="ParameterName"/>      <!-- camelCase params -->
        <module name="LocalVariableName"/>  <!-- camelCase locals -->
        <!-- Allow UPPER_SNAKE_CASE constants AND lowercase log/logger fields (SLF4J convention) -->
        <module name="ConstantName">
            <property name="format" value="^(log(ger)?|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>

        <!-- ── Correctness ─────────────────────────────────────────────── -->
        <module name="EqualsHashCode"/>           <!-- override both or neither -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>    <!-- no == on strings -->
        <module name="NoFinalizer"/>              <!-- no finalize() -->

        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
        </module>

        <!-- ── Misc ────────────────────────────────────────────────────── -->
        <module name="UpperEll"/>       <!-- use L not l for long literals -->
        <module name="ArrayTypeStyle"/> <!-- String[] args not String args[] -->

    </module>
</module>
