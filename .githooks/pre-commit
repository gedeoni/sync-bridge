#!/usr/bin/env bash

# Robust unified pre-commit hook for sync-bridge monorepo.
# This script runs tests and linters only on the projects affected by staged changes.

set -uo pipefail

# ANSI color codes for premium terminal output formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${CYAN}──────────────────────────────────────────────────${NC}"
echo -e "${BOLD}${CYAN}🔍 Unified Monorepo Pre-Commit Hook${NC}"
echo -e "${BOLD}${CYAN}──────────────────────────────────────────────────${NC}"

# 1. Get all staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ No staged files found. Proceeding with commit.${NC}"
    exit 0
fi

# Store the root path of the monorepo
ROOT_DIR=$(pwd)

# Flag to track if checks were executed
CHECKS_RUN=0

# -----------------------------------------------------------------------------
# NestJS checks (sync-bridge-nestjs)
# -----------------------------------------------------------------------------
NESTJS_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-nestjs/' || true)
if [ -n "$NESTJS_STAGED" ]; then
    NUM_NEST_FILES=$(echo "$NESTJS_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}📦 NestJS project changes detected ($NUM_NEST_FILES files staged)${NC}"
    echo -e "${CYAN}Running NestJS lint and tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-nestjs"
    
    echo -e "🧹 Running lint-staged (eslint)..."
    if ! npx lint-staged; then
        echo -e "${RED}${BOLD}✗ NestJS linting failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running unit tests..."
    if ! npm run test; then
        echo -e "${RED}${BOLD}✗ NestJS unit tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running e2e tests..."
    if ! npm run test:e2e; then
        echo -e "${RED}${BOLD}✗ NestJS E2E tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ NestJS checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Express checks (sync-bridge-express)
# -----------------------------------------------------------------------------
EXPRESS_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-express/' || true)
if [ -n "$EXPRESS_STAGED" ]; then
    NUM_EXPRESS_FILES=$(echo "$EXPRESS_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}⚡ Express project changes detected ($NUM_EXPRESS_FILES files staged)${NC}"
    echo -e "${CYAN}Running Express lint and formatting...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-express"
    
    echo -e "🧹 Running pretty-quick formatting check..."
    if ! npx pretty-quick --staged; then
        echo -e "${RED}${BOLD}✗ Express formatting check failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧹 Running lint-staged (eslint)..."
    if ! npx lint-staged; then
        echo -e "${RED}${BOLD}✗ Express linting failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Express checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Django checks (sync-bridge-django)
# -----------------------------------------------------------------------------
DJANGO_PY_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-django/.*\.py$' || true)
if [ -n "$DJANGO_PY_STAGED" ]; then
    NUM_PY_FILES=$(echo "$DJANGO_PY_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}🐍 Django project Python changes detected ($NUM_PY_FILES files staged)${NC}"
    echo -e "${CYAN}Running Django linters and tests...${NC}"
    
    # Strip the prefix to get paths relative to sync-bridge-django/
    RELATIVE_PY_STAGED=$(echo "$DJANGO_PY_STAGED" | sed 's|^sync-bridge-django/||')
    
    cd "$ROOT_DIR/sync-bridge-django"
    
    echo -e "🧹 Running Ruff lint checks..."
    if ! echo "$RELATIVE_PY_STAGED" | xargs uv run ruff check; then
        echo -e "${RED}${BOLD}✗ Django Ruff lint checks failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧹 Running Ruff formatting checks..."
    if ! echo "$RELATIVE_PY_STAGED" | xargs uv run ruff format --check; then
        echo -e "${RED}${BOLD}✗ Django Ruff formatting check failed. Run 'uv run ruff format' inside sync-bridge-django directory. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running Django unit tests..."
    export APP_AUTH_TOKEN='pre-commit-secret-token'
    export SECRET_KEY='pre-commit-secret-key-for-testing'
    if ! uv run python manage.py test; then
        echo -e "${RED}${BOLD}✗ Django unit tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Django checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Java checks (sync-bridge-java)
# -----------------------------------------------------------------------------
JAVA_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-java/.*\.java$' || true)
if [ -n "$JAVA_STAGED" ]; then
    NUM_JAVA_FILES=$(echo "$JAVA_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}☕ Java project changes detected ($NUM_JAVA_FILES files staged)${NC}"
    echo -e "${CYAN}Running Java Checkstyle and Maven tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-java"
    
    echo -e "🧹 Running Java Checkstyle..."
    if ! mvn --batch-mode --quiet checkstyle:check 2>&1; then
        echo -e "${RED}${BOLD}✗ Java Checkstyle failed. Run 'mvn checkstyle:check' inside sync-bridge-java directory for details. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running Maven unit/integration tests..."
    if ! mvn --batch-mode --quiet test 2>&1; then
        echo -e "${RED}${BOLD}✗ Java tests failed. Run 'mvn test' inside sync-bridge-java directory for details. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Java checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Final output
# -----------------------------------------------------------------------------
cd "$ROOT_DIR"
if [ "$CHECKS_RUN" -eq 0 ]; then
    echo -e "\n${GREEN}✓ Staged changes are outside monitored project folders or do not require code checks. Proceeding with commit.${NC}"
else
    echo -e "\n${BOLD}${GREEN}✅ All unified pre-commit checks passed successfully! Proceeding with commit.${NC}"
fi

echo -e "${BOLD}${CYAN}──────────────────────────────────────────────────${NC}"
exit 0
