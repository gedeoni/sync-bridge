#!/usr/bin/env bash

# Robust unified pre-commit hook for sync-bridge monorepo.
# This script runs tests and linters only on the projects affected by staged changes.

set -uo pipefail

# ANSI color codes for premium terminal output formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${CYAN}──────────────────────────────────────────────────${NC}"
echo -e "${BOLD}${CYAN}🔍 Unified Monorepo Pre-Commit Hook${NC}"
echo -e "${BOLD}${CYAN}──────────────────────────────────────────────────${NC}"

# 1. Get all staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ No staged files found. Proceeding with commit.${NC}"
    exit 0
fi

# Store the root path of the monorepo
ROOT_DIR=$(pwd)

# Flag to track if checks were executed
CHECKS_RUN=0
# Detect affected sub-projects
AFFECTED_PROJECTS=()
if echo "$STAGED_FILES" | grep -q '^sync-bridge-nestjs/'; then AFFECTED_PROJECTS+=("NestJS"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-express/'; then AFFECTED_PROJECTS+=("Express"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-django/'; then AFFECTED_PROJECTS+=("Django"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-java/'; then AFFECTED_PROJECTS+=("Java"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-rust/'; then AFFECTED_PROJECTS+=("Rust"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-go/'; then AFFECTED_PROJECTS+=("Go"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-fastapi/'; then AFFECTED_PROJECTS+=("FastAPI"); fi
if echo "$STAGED_FILES" | grep -q '^sync-bridge-csharp/'; then AFFECTED_PROJECTS+=("C#"); fi

if [ ${#AFFECTED_PROJECTS[@]} -gt 0 ]; then
    PROJECTS_LIST=$(printf ", %s" "${AFFECTED_PROJECTS[@]}")
    PROJECTS_LIST=${PROJECTS_LIST:2}
    echo -e "${BOLD}${CYAN}👉 Staged changes affect: ${PROJECTS_LIST}${NC}\n"
else
    echo -e "${BOLD}${CYAN}👉 Staged changes affect: Global configurations${NC}\n"
fi

# -----------------------------------------------------------------------------
# NestJS checks (sync-bridge-nestjs)
# -----------------------------------------------------------------------------
NESTJS_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-nestjs/' || true)
if [ -n "$NESTJS_STAGED" ]; then
    NUM_NEST_FILES=$(echo "$NESTJS_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}📦 NestJS project changes detected ($NUM_NEST_FILES files staged)${NC}"
    echo -e "${CYAN}Running NestJS lint and tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-nestjs"
    
    echo -e "🧹 Running lint-staged (eslint)..."
    if ! npx lint-staged; then
        echo -e "${RED}${BOLD}✗ NestJS linting failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running unit tests with coverage..."
    if ! npm run test:cov; then
        echo -e "${RED}${BOLD}✗ NestJS unit tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running e2e tests..."
    if ! npm run test:e2e; then
        echo -e "${RED}${BOLD}✗ NestJS E2E tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ NestJS checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Express checks (sync-bridge-express)
# -----------------------------------------------------------------------------
EXPRESS_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-express/' || true)
if [ -n "$EXPRESS_STAGED" ]; then
    NUM_EXPRESS_FILES=$(echo "$EXPRESS_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}⚡ Express project changes detected ($NUM_EXPRESS_FILES files staged)${NC}"
    echo -e "${CYAN}Running Express lint and formatting...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-express"
    
    echo -e "🧹 Running pretty-quick formatting check..."
    if ! npx pretty-quick --staged; then
        echo -e "${RED}${BOLD}✗ Express formatting check failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧹 Running lint-staged (eslint)..."
    if ! npx lint-staged; then
        echo -e "${RED}${BOLD}✗ Express linting failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running unit tests with coverage..."
    if ! npm test -- --coverage; then
        echo -e "${RED}${BOLD}✗ Express unit tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Express checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Django checks (sync-bridge-django)
# -----------------------------------------------------------------------------
DJANGO_PY_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-django/.*\.py$' || true)
if [ -n "$DJANGO_PY_STAGED" ]; then
    NUM_PY_FILES=$(echo "$DJANGO_PY_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}🐍 Django project Python changes detected ($NUM_PY_FILES files staged)${NC}"
    echo -e "${CYAN}Running Django linters and tests...${NC}"
    
    # Strip the prefix to get paths relative to sync-bridge-django/
    RELATIVE_PY_STAGED=$(echo "$DJANGO_PY_STAGED" | sed 's|^sync-bridge-django/||')
    
    cd "$ROOT_DIR/sync-bridge-django"
    
    echo -e "🧹 Running Ruff lint checks..."
    if ! echo "$RELATIVE_PY_STAGED" | xargs uv run ruff check; then
        echo -e "${RED}${BOLD}✗ Django Ruff lint checks failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧹 Running Ruff formatting checks..."
    if ! echo "$RELATIVE_PY_STAGED" | xargs uv run ruff format --check; then
        echo -e "${RED}${BOLD}✗ Django Ruff formatting check failed. Run 'uv run ruff format' inside sync-bridge-django directory. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running Django unit tests with coverage..."
    export APP_AUTH_TOKEN='pre-commit-secret-token'
    export SECRET_KEY='pre-commit-secret-key-for-testing'
    if ! uv run coverage run manage.py test; then
        echo -e "${RED}${BOLD}✗ Django unit tests failed. Aborting commit.${NC}"
        exit 1
    fi
    uv run coverage json -o coverage.json
    
    echo -e "${GREEN}✓ Django checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# FastAPI checks (sync-bridge-fastapi)
# -----------------------------------------------------------------------------
FASTAPI_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-fastapi/' || true)
if [ -n "$FASTAPI_STAGED" ]; then
    NUM_FASTAPI_FILES=$(echo "$FASTAPI_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}🐍 FastAPI project changes detected ($NUM_FASTAPI_FILES files staged)${NC}"
    echo -e "${CYAN}Running FastAPI linters and tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-fastapi"
    
    # Check if virtualenv is present, if not warn/setup
    if [ ! -d ".venv" ]; then
        echo -e "${YELLOW}Virtual environment .venv not found. Running uv venv...${NC}"
        uv venv --quiet
        source .venv/bin/activate
        uv pip install -r requirements.txt --quiet
    else
        source .venv/bin/activate
    fi

    echo -e "🧹 Running Ruff lint checks..."
    if ! ruff check .; then
        echo -e "${RED}${BOLD}✗ FastAPI Ruff lint checks failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧹 Running Ruff formatting checks..."
    if ! ruff format --check .; then
        echo -e "${RED}${BOLD}✗ FastAPI Ruff formatting check failed. Run 'ruff format .' inside sync-bridge-fastapi directory. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running FastAPI unit/integration tests with coverage..."
    if ! PYTHONPATH=. pytest --cov=. --cov-report=json; then
        echo -e "${RED}${BOLD}✗ FastAPI unit tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ FastAPI checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Java checks (sync-bridge-java)
# -----------------------------------------------------------------------------
JAVA_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-java/.*\.java$' || true)
if [ -n "$JAVA_STAGED" ]; then
    NUM_JAVA_FILES=$(echo "$JAVA_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}☕ Java project changes detected ($NUM_JAVA_FILES files staged)${NC}"
    echo -e "${CYAN}Running Java Checkstyle and Maven tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-java"
    
    echo -e "🧹 Running Java Checkstyle..."
    if ! mvn --batch-mode --quiet checkstyle:check 2>&1; then
        echo -e "${RED}${BOLD}✗ Java Checkstyle failed. Run 'mvn checkstyle:check' inside sync-bridge-java directory for details. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running Maven unit/integration tests..."
    if ! mvn --batch-mode --quiet test 2>&1; then
        echo -e "${RED}${BOLD}✗ Java tests failed. Run 'mvn test' inside sync-bridge-java directory for details. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Java checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Rust checks (sync-bridge-rust)
# -----------------------------------------------------------------------------
RUST_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-rust/' || true)
if [ -n "$RUST_STAGED" ]; then
    NUM_RUST_FILES=$(echo "$RUST_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}🦀 Rust project changes detected ($NUM_RUST_FILES files staged)${NC}"
    echo -e "${CYAN}Running Rust format, clippy and tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-rust"
    
    echo -e "🧹 Running cargo fmt..."
    if ! cargo fmt -- --check; then
        echo -e "${RED}${BOLD}✗ Rust formatting checks failed. Run 'cargo fmt' inside sync-bridge-rust directory. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧹 Running cargo clippy..."
    if ! cargo clippy -- -D warnings; then
        echo -e "${RED}${BOLD}✗ Rust clippy checks failed. Aborting commit.${NC}"
        exit 1
    fi
    
    if command -v cargo-tarpaulin &> /dev/null; then
        echo -e "🧪 Running Rust unit/integration tests with coverage..."
        if ! cargo tarpaulin --all-targets --out Json --output-dir .; then
            echo -e "${RED}${BOLD}✗ Rust tests failed. Aborting commit.${NC}"
            exit 1
        fi
    else
        echo -e "🧪 Running cargo test..."
        if ! cargo test; then
            echo -e "${RED}${BOLD}✗ Rust unit/integration tests failed. Aborting commit.${NC}"
            exit 1
        fi
    fi
    
    echo -e "${GREEN}✓ Rust checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Go checks (sync-bridge-go)
# -----------------------------------------------------------------------------
GO_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-go/' || true)
if [ -n "$GO_STAGED" ]; then
    NUM_GO_FILES=$(echo "$GO_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}🐹 Go project changes detected ($NUM_GO_FILES files staged)${NC}"
    echo -e "${CYAN}Running Go fmt and tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-go"
    
    echo -e "🧹 Running go fmt..."
    # Format check: if gofmt -l reports any files, fail
    UNFORMATTED_FILES=$(gofmt -l .)
    if [ -n "$UNFORMATTED_FILES" ]; then
        echo -e "${RED}${BOLD}✗ Go files are not formatted correctly. Run 'go fmt ./...' inside sync-bridge-go. Aborting commit.${NC}"
        echo "$UNFORMATTED_FILES"
        exit 1
    fi
    
    echo -e "🧪 Running go test with coverage..."
    if ! go test -coverprofile=coverage.out ./...; then
        echo -e "${RED}${BOLD}✗ Go tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Go checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# C# checks (sync-bridge-csharp)
# -----------------------------------------------------------------------------
CSHARP_STAGED=$(echo "$STAGED_FILES" | grep '^sync-bridge-csharp/' || true)
if [ -n "$CSHARP_STAGED" ]; then
    NUM_CSHARP_FILES=$(echo "$CSHARP_STAGED" | wc -l | xargs)
    echo -e "\n${BOLD}${YELLOW}🎯 C# project changes detected ($NUM_CSHARP_FILES files staged)${NC}"
    echo -e "${CYAN}Running C# formatting checks and tests...${NC}"
    
    cd "$ROOT_DIR/sync-bridge-csharp"
    
    echo -e "🧹 Running dotnet format check..."
    if ! dotnet format --verify-no-changes; then
        echo -e "${RED}${BOLD}✗ C# files are not formatted correctly. Run 'dotnet format' inside sync-bridge-csharp. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "🧪 Running dotnet tests with coverage..."
    if ! dotnet test --collect:"XPlat Code Coverage"; then
        echo -e "${RED}${BOLD}✗ C# tests failed. Aborting commit.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ C# checks passed successfully.${NC}"
    CHECKS_RUN=$((CHECKS_RUN + 1))
fi

# -----------------------------------------------------------------------------
# Final output & Update README coverage
# -----------------------------------------------------------------------------
cd "$ROOT_DIR"
if [ "$CHECKS_RUN" -eq 0 ]; then
    echo -e "\n${GREEN}✓ Staged changes are outside monitored project folders or do not require code checks. Proceeding with commit.${NC}"
else
    echo -e "\n${BOLD}${CYAN}📊 Updating README.md coverage badges...${NC}"
    if node scripts/update-readme-coverage.js; then
        # If README.md was modified, stage it automatically
        git add README.md
        echo -e "${GREEN}✓ README.md coverage badges updated and staged.${NC}"
    else
        echo -e "${YELLOW}⚠ Failed to update README.md coverage badges automatically.${NC}"
    fi
    echo -e "\n${BOLD}${GREEN}✅ All unified pre-commit checks passed successfully! Proceeding with commit.${NC}"
fi

echo -e "${BOLD}${CYAN}──────────────────────────────────────────────────${NC}"
exit 0
